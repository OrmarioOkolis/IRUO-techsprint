<?php
// Generirano Ansibleom - ne uredjuj rucno, izmjene ce biti prepisane.
unset($CFG);
global $CFG;
$CFG = new stdClass();

$CFG->dbtype    = 'mariadb';
$CFG->dblibrary = 'native';
// Azure HA par: moodle_db_host = privatni IP primarne instance (dijeljena
// baza, vidi generate_inventory.py / moodle rolu). OpenStack / samostalna
// instanca: nije postavljeno -> 'localhost' (svaka instanca svoja baza).
$CFG->dbhost    = '{{ moodle_db_host | default("localhost") }}';
$CFG->dbname    = '{{ moodle_db_name }}';
$CFG->dbuser    = '{{ moodle_db_user }}';
$CFG->dbpass    = '{{ moodle_db_password }}';
$CFG->prefix    = 'mdl_';
$CFG->dboptions = array(
  'dbpersist' => 0,
  'dbport' => '',
  'dbsocket' => '',
  'dbcollation' => 'utf8mb4_unicode_ci',
);

// Isti wwwroot na obje instance u HA paru - internal LB frontend IP,
// ne privatni IP pojedine VM (session/URL konzistentnost iza load balancera).
$CFG->wwwroot   = '{{ moodle_wwwroot }}';
$CFG->dataroot  = '{{ moodle_dataroot }}';
$CFG->admin     = 'admin';

// Sesije u BAZI, ne u datotekama. moodledata je na blobfuse2 (Azure) / rclone
// Swift (OpenStack) - oba su FUSE i ne podrzavaju flock() koji PHP file
// session handler treba, pa se sesija gubi izmedju zahtjeva ("Invalid login"
// nakon cookie-check redirecta). DB sesije su uz to i ispravan HA obrazac:
// obje instance iza LB-a dijele isto stanje sesije (dijeljena baza).
$CFG->session_handler_class = '\core\session\database';
$CFG->session_database_acquire_lock_timeout = 120;

$CFG->directorypermissions = 0770;

require_once(__DIR__ . '/lib/setup.php');
